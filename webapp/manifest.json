{
  "_version": "1.73.1",
  "sap.app": {
    "id": "zmes.zmesppoplist",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:feop",
      "version": "1.26.0",
      "toolsId": "46438c3c-b6be-44cb-8718-6a2d629f4346"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mes_pp_operation_v4/srvd/sap/zui_mes_pp_operation/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "gosService": {
        "uri": "/sap/opu/odata4/sap/zui_gos_url_link_v4/srvd/sap/zui_gos_url_link/0001/",
        "type": "OData",
        "settings": {
          "localUri": "localService/gosService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZmesProdOper-manage": {
          "semanticObject": "ZmesProdOper",
          "action": "manage",
          "title": "{{ZmesProdOper-manage.flpTitle}}",
          "subTitle": "{{ZmesProdOper-manage.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      },
      "outbounds": {
        "toConfSingle": {
          "semanticObject": "zmesconfsingle",
          "action": "manage",
          "parameters": [
            {
              "value": {
                "value": "ManufacturingOrder",
                "format": "binding"
              },
              "target": {
                "parameter": "ManufacturingOrder"
              }
            },
            {
              "value": {
                "value": "ManufacturingOrderOperation",
                "format": "binding"
              },
              "target": {
                "parameter": "ManufacturingOrderOperation"
              }
            }
          ]
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController#zmes.zmesppoplist::SessionObjectPage": {
            "controllerName": "zmes.zmesppoplist.ext.controller.SessionObjectPageController"
          }
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zmes.zmesppoplist.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "gosModel": {
        "dataSource": "gosService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": "Session({key}):?query:",
          "name": "SessionObjectPage",
          "target": "SessionObjectPage"
        },
        {
          "pattern": "Session({key})/_Operations({key2}):?query:",
          "name": "OperationObjectPage",
          "target": "OperationObjectPage"
        }
      ],
      "targets": {
        "SessionObjectPage": {
          "type": "Component",
          "id": "SessionObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Session",
              "content": {
                "header": {
                  "visible": true,
                  "anchorBarVisible": false
                }
              },
              "navigation": {
                "_Operations": {
                  "detail": {
                    "outbound": "toConfSingle"
                  }
                }
              },
              "controlConfiguration": {
                "_Operations/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "selectionMode": "Multi",
                    "enableExport": false
                  },
                  "actions": {
                    "scanBarcode": {
                      "press": "zmes.zmesppoplist.ext.controller.ScanHandler.onScanBarcode",
                      "text": "Keresés",
                      "enabled": true
                    },
                    "clearScan": {
                      "press": "zmes.zmesppoplist.ext.controller.ScanHandler.onClearScan",
                      "text": "Összes tétel",
                      "enabled": true,
                      "visible": false
                    }
                  },
                  "columns": {
                    "gosColumn": {
                      "header": "Műszaki rajz",
                      "width": "3rem",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::Material"
                      },
                      "template": "zmes.zmesppoplist.ext.fragment.GosColumn"
                    },
                    "equipmentColumn": {
                      "header": "Karb.",
                      "width": "3rem",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::WorkCenterID"
                      },
                      "template": "zmes.zmesppoplist.ext.fragment.EquipmentColumn"
                    }
                  }
                },
                "_AppNav/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "enableExport": false
                  }
                }
              }
            }
          }
        },
        "OperationObjectPage": {
          "type": "Component",
          "id": "OperationObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Session/_Operations"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true,
      "share": {
        "showSendEmail": false
      }
    }
  }
}